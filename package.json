{
  "name": "tableu",
  "productName": "TableU",
  "version": "2.2.0",
  "description": "Trình xem bảng và chạy truy vấn MySQL / PostgreSQL, gọn nhẹ cho Linux",
  "main": "main.js",
  "author": {
    "name": "Trần Nguyên Tỉnh",
    "email": "tinh.icolor@gmail.com"
  },
  "license": "Miễn phí",
  "scripts": {
    "start": "ELECTRON_RUN_AS_NODE= electron .",
    "dev": "ELECTRON_RUN_AS_NODE= electron . --enable-logging",
    "test": "node test/run.js",
    "pack": "electron-builder --linux dir",
    "dist:deb": "node scripts/dong-goi.js deb",
    "dist": "node scripts/dong-goi.js deb"
  },
  "dependencies": {
    "mysql2": "^3.11.5",
    "pg": "^8.23.1",
    "pg-query-stream": "^4.17.1",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "codemirror": "^5.65.21",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.tableu.client",
    "productName": "TableU",
    "copyright": "Copyright © 2026 tinhtn",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "maintainer": "Trần Nguyên Tỉnh <tinh.icolor@gmail.com>",
      "synopsis": "Trình xem bảng và chạy truy vấn MySQL / PostgreSQL",
      "description": "Trình xem bảng gọn nhẹ cho Linux, dùng được với MySQL/MariaDB và PostgreSQL: duyệt database, xem và sửa dữ liệu dạng lưới, viết SQL.",
      "desktop": {
        "entry": {
          "Name": "TableU",
          "Comment": "Trình xem bảng MySQL",
          "Keywords": "mysql;database;sql;",
          "StartupWMClass": "TableU"
        }
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libsecret-1-0"
      ]
    },
    "electronLanguages": [
      "en-US",
      "vi"
    ]
  },
  "homepage": "https://example.com/tableu"
}
